<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Phase 1.1 — the "missing basics": photo (Student/Teacher/Guardian, via platform
         StorageService/FileMetadata, never a raw URL column) and roll number (StudentClassroomLink,
         not Student — roll number is per-classroom-per-academic-year, see that entity's Javadoc). -->

    <!-- photo_file_public_id references platform's file_metadata.public_id (the UUID publicId),
         never file_metadata.id — see Student.photoFilePublicId's Javadoc. file_metadata.public_id
         is declared UNIQUE (ExposedEntity), so it's a valid FK target despite not being that
         table's primary key. type="UUID" matches file_metadata.public_id's own column
         declaration (platform-saas 009-files-privacy.xml) so the FK's column types agree. -->
    <changeSet id="school-135-student-photo" author="school">
        <addColumn tableName="students">
            <column name="photo_file_public_id" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint
                constraintName="fk_students_photo_file_public_id"
                baseTableName="students" baseColumnNames="photo_file_public_id"
                referencedTableName="file_metadata" referencedColumnNames="public_id"/>
    </changeSet>

    <changeSet id="school-136-teacher-photo" author="school">
        <addColumn tableName="teachers">
            <column name="photo_file_public_id" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint
                constraintName="fk_teachers_photo_file_public_id"
                baseTableName="teachers" baseColumnNames="photo_file_public_id"
                referencedTableName="file_metadata" referencedColumnNames="public_id"/>
    </changeSet>

    <changeSet id="school-137-guardian-photo" author="school">
        <addColumn tableName="guardians">
            <column name="photo_file_public_id" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint
                constraintName="fk_guardians_photo_file_public_id"
                baseTableName="guardians" baseColumnNames="photo_file_public_id"
                referencedTableName="file_metadata" referencedColumnNames="public_id"/>
    </changeSet>

    <changeSet id="school-138-classroom-link-roll-number" author="school">
        <addColumn tableName="student_classroom_links">
            <column name="roll_number" type="VARCHAR(20)"/>
        </addColumn>

        <!-- Soft-delete-safe unique index from the start (see
             052-generalize-soft-delete-unique-index-fix.xml for the pattern this follows): a plain
             unique constraint on (classroom_id, academic_year_id, roll_number) would let a
             withdrawn/soft-deleted link's roll number block its reuse. Rows with no roll number
             assigned yet are also NULL here and, correctly, never collide with each other either. -->
        <sql>
            ALTER TABLE student_classroom_links
            ADD COLUMN active_roll_number VARCHAR(20)
            GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN roll_number ELSE NULL END) VIRTUAL
        </sql>
        <createIndex indexName="uq_scl_classroom_year_active_roll_number" tableName="student_classroom_links"
                     unique="true">
            <column name="classroom_id"/>
            <column name="academic_year_id"/>
            <column name="active_roll_number"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

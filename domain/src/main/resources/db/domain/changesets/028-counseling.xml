<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-079-counseling-sessions" author="school">
        <createTable tableName="counseling_sessions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="counselor_teacher_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="session_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="VARCHAR(2000)"/>
            <column name="follow_up_required" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_counseling_sessions_tenant_id" tableName="counseling_sessions">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_counseling_sessions_deleted" tableName="counseling_sessions">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_counseling_sessions_student_id" tableName="counseling_sessions">
            <column name="student_id"/>
        </createIndex>
        <createIndex indexName="idx_counseling_sessions_counselor_teacher_id" tableName="counseling_sessions">
            <column name="counselor_teacher_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_counseling_sessions_tenant_id"
                baseTableName="counseling_sessions"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_counseling_sessions_student_id"
                baseTableName="counseling_sessions"
                baseColumnNames="student_id"
                referencedTableName="students"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_counseling_sessions_counselor_teacher_id"
                baseTableName="counseling_sessions"
                baseColumnNames="counselor_teacher_id"
                referencedTableName="teachers"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-080-counseling-referrals" author="school">
        <createTable tableName="counseling_referrals">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="counseling_session_id" type="BIGINT"/>
            <column name="referred_by_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="referred_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_counseling_referrals_tenant_id" tableName="counseling_referrals">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_counseling_referrals_deleted" tableName="counseling_referrals">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_counseling_referrals_status" tableName="counseling_referrals">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_counseling_referrals_student_id" tableName="counseling_referrals">
            <column name="student_id"/>
        </createIndex>
        <createIndex indexName="idx_counseling_referrals_counseling_session_id" tableName="counseling_referrals">
            <column name="counseling_session_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_counseling_referrals_tenant_id"
                baseTableName="counseling_referrals"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_counseling_referrals_student_id"
                baseTableName="counseling_referrals"
                baseColumnNames="student_id"
                referencedTableName="students"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_counseling_referrals_counseling_session_id"
                baseTableName="counseling_referrals"
                baseColumnNames="counseling_session_id"
                referencedTableName="counseling_sessions"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

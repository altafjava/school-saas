<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-201-fee-invoices" author="school">
        <createTable tableName="fee_invoices">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="document_issuance_id" type="BIGINT"/>
            <column name="invoice_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="period_start" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_end" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="issue_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="due_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="cancelled_at" type="TIMESTAMP"/>
            <column name="cancellation_reason" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="deleted_token" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="retired_token" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_fee_invoices_student"
                baseTableName="fee_invoices" baseColumnNames="student_id"
                referencedTableName="students" referencedColumnNames="id"/>
        <createIndex indexName="idx_fee_invoices_tenant_id" tableName="fee_invoices">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_fee_invoices_student_id" tableName="fee_invoices">
            <column name="student_id"/>
        </createIndex>
        <createIndex indexName="idx_fee_invoices_status" tableName="fee_invoices">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_fee_invoices_deleted" tableName="fee_invoices">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_fee_invoices_created_at" tableName="fee_invoices">
            <column name="created_at"/>
        </createIndex>
        <createIndex indexName="idx_fee_invoices_due_date" tableName="fee_invoices">
            <column name="due_date"/>
        </createIndex>
        <createIndex indexName="uq_fee_invoices_number" tableName="fee_invoices" unique="true">
            <column name="tenant_id"/>
            <column name="invoice_number"/>
            <column name="deleted_token"/>
        </createIndex>
        <createIndex indexName="uq_fee_invoices_student_period" tableName="fee_invoices" unique="true">
            <column name="tenant_id"/>
            <column name="student_id"/>
            <column name="period_start"/>
            <column name="period_end"/>
            <column name="retired_token"/>
            <column name="deleted_token"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-202-fee-invoice-lines" author="school">
        <createTable tableName="fee_invoice_lines">
            <column name="invoice_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="line_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="fee_structure_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="installment_number" type="INT"/>
            <column name="description" type="VARCHAR(300)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="fee_invoice_lines" columnNames="invoice_id, line_number"
                constraintName="pk_fee_invoice_lines"/>
        <addForeignKeyConstraint constraintName="fk_fee_invoice_lines_invoice"
                baseTableName="fee_invoice_lines" baseColumnNames="invoice_id"
                referencedTableName="fee_invoices" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_fee_invoice_lines_fee_structure"
                baseTableName="fee_invoice_lines" baseColumnNames="fee_structure_id"
                referencedTableName="fee_structures" referencedColumnNames="id"/>
        <createIndex indexName="idx_fee_invoice_lines_fee_structure_id" tableName="fee_invoice_lines">
            <column name="fee_structure_id"/>
        </createIndex>
        <addForeignKeyConstraint constraintName="fk_fee_payments_invoice"
                baseTableName="fee_payments" baseColumnNames="invoice_id"
                referencedTableName="fee_invoices" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Phase 3.3 — physical venues for timetable slots (so one room cannot be booked twice in the
         same period) and dated substitute-teacher assignments for a regular slot. -->

    <changeSet id="school-164-venues" author="school">
        <createTable tableName="venues">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="venue_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="capacity" type="INT"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_venues_tenant_id"
                baseTableName="venues" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <sql>
            ALTER TABLE venues
            ADD COLUMN active_code VARCHAR(50)
            GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN code ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="uq_venues_tenant_active_code" tableName="venues" unique="true">
            <column name="tenant_id"/>
            <column name="active_code"/>
        </createIndex>
        <createIndex indexName="idx_venues_tenant_id" tableName="venues">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_venues_deleted" tableName="venues">
            <column name="deleted"/>
        </createIndex>
        <sql>
            ALTER TABLE venues ADD CONSTRAINT chk_venues_capacity CHECK (capacity IS NULL OR capacity > 0)
        </sql>
    </changeSet>

    <changeSet id="school-165-timetable-entry-venue" author="school">
        <addColumn tableName="timetable_entries">
            <column name="venue_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_timetable_entries_venue_id"
                baseTableName="timetable_entries" baseColumnNames="venue_id"
                referencedTableName="venues" referencedColumnNames="id"/>
        <createIndex indexName="idx_timetable_entries_venue_id" tableName="timetable_entries">
            <column name="venue_id"/>
        </createIndex>
        <!-- One live booking per venue and slot; slots without a venue (NULL) never collide. -->
        <sql>
            ALTER TABLE timetable_entries
            ADD COLUMN active_venue_id BIGINT
            GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN venue_id ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="uq_timetable_active_venue_period_day" tableName="timetable_entries" unique="true">
            <column name="tenant_id"/>
            <column name="day_of_week"/>
            <column name="period_id"/>
            <column name="active_venue_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-166-timetable-substitutions" author="school">
        <createTable tableName="timetable_substitutions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="timetable_entry_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="period_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="substitution_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="substitute_teacher_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="assigned_by_user_id" type="BIGINT"/>
            <column name="cancelled_at" type="TIMESTAMP"/>
            <column name="cancellation_reason" type="VARCHAR(500)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_timetable_substitutions_tenant_id"
                baseTableName="timetable_substitutions" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_timetable_substitutions_entry_id"
                baseTableName="timetable_substitutions" baseColumnNames="timetable_entry_id"
                referencedTableName="timetable_entries" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_timetable_substitutions_period_id"
                baseTableName="timetable_substitutions" baseColumnNames="period_id"
                referencedTableName="periods" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_timetable_substitutions_teacher_id"
                baseTableName="timetable_substitutions" baseColumnNames="substitute_teacher_id"
                referencedTableName="teachers" referencedColumnNames="id"/>
        <!-- 1 while the substitution stands, NULL once cancelled or deleted: lets a cancelled slot be
             covered again while still allowing only one live cover per slot and per substitute. -->
        <sql>
            ALTER TABLE timetable_substitutions
            ADD COLUMN live_marker TINYINT
            GENERATED ALWAYS AS (CASE WHEN deleted = FALSE AND cancelled_at IS NULL THEN 1 ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="uq_timetable_substitutions_live_entry_date" tableName="timetable_substitutions"
                     unique="true">
            <column name="tenant_id"/>
            <column name="timetable_entry_id"/>
            <column name="substitution_date"/>
            <column name="live_marker"/>
        </createIndex>
        <createIndex indexName="uq_timetable_substitutions_live_teacher_period_date"
                     tableName="timetable_substitutions" unique="true">
            <column name="tenant_id"/>
            <column name="substitute_teacher_id"/>
            <column name="period_id"/>
            <column name="substitution_date"/>
            <column name="live_marker"/>
        </createIndex>
        <createIndex indexName="idx_timetable_substitutions_tenant_date" tableName="timetable_substitutions">
            <column name="tenant_id"/>
            <column name="substitution_date"/>
        </createIndex>
        <createIndex indexName="idx_timetable_substitutions_deleted" tableName="timetable_substitutions">
            <column name="deleted"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-167-venue-and-substitution-permissions" author="school">
        <sql>
            UPDATE roles
            SET permissions_json = JSON_MERGE_PRESERVE(permissions_json, '["VENUE_MANAGE", "SUBSTITUTION_MANAGE"]')
            WHERE name IN ('TENANT_ADMIN', 'ACADEMIC');
        </sql>
    </changeSet>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Append-only correction history for HealthRecord — see HealthRecordCorrection's Javadoc:
         HealthRecord.upsert() previously overwrote PHI-grade fields in place with no history at
         all. Mirrors 038-correction-history.xml's grade_corrections/attendance_corrections shape. -->
    <changeSet id="school-134-health-record-corrections" author="school">
        <createTable tableName="health_record_corrections">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="health_record_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="old_blood_group" type="VARCHAR(10)"/>
            <column name="old_allergies" type="VARCHAR(1000)"/>
            <column name="old_conditions" type="VARCHAR(1000)"/>
            <column name="old_immunizations" type="VARCHAR(1000)"/>
            <column name="new_blood_group" type="VARCHAR(10)"/>
            <column name="new_allergies" type="VARCHAR(1000)"/>
            <column name="new_conditions" type="VARCHAR(1000)"/>
            <column name="new_immunizations" type="VARCHAR(1000)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_health_record_corrections_tenant_id" tableName="health_record_corrections">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_health_record_corrections_health_record_id" tableName="health_record_corrections">
            <column name="health_record_id"/>
        </createIndex>
        <createIndex indexName="idx_health_record_corrections_deleted" tableName="health_record_corrections">
            <column name="deleted"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_health_record_corrections_health_record_id"
                baseTableName="health_record_corrections"
                baseColumnNames="health_record_id"
                referencedTableName="health_records"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_health_record_corrections_tenant_id"
                baseTableName="health_record_corrections"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Global system-role templates (tenant_id = NULL) for the role-scoped dashboards — same
         pattern as 008-seed-school-roles.xml's TEACHER/STUDENT/PARENT. -->
    <changeSet id="school-054-seed-dashboard-roles" author="school">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM roles WHERE name = 'PRINCIPAL' AND tenant_id IS NULL</sqlCheck>
        </preConditions>
        <insert tableName="roles">
            <column name="name" value="PRINCIPAL"/>
            <column name="description" value="School-wide summary dashboard: enrollment, attendance, GPA, events"/>
            <column name="is_system_role" valueBoolean="true"/>
            <column name="permissions_json" value='["CERTIFICATE_MANAGE", "CERTIFICATE_TYPE_READ", "DASHBOARD_PRINCIPAL_READ"]'/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_at" valueDate="NOW()"/>
        </insert>

        <insert tableName="roles">
            <column name="name" value="FINANCE"/>
            <column name="description" value="Finance dashboard: fee collection, outstanding balances, library fines"/>
            <column name="is_system_role" valueBoolean="true"/>
            <column name="permissions_json" value='["DASHBOARD_FINANCE_READ", "PAYSLIP_DISBURSE"]'/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_at" valueDate="NOW()"/>
        </insert>

        <insert tableName="roles">
            <column name="name" value="HR"/>
            <column name="description" value="HR dashboard: staff headcount, leave requests, leave balances"/>
            <column name="is_system_role" valueBoolean="true"/>
            <column name="permissions_json" value='["DASHBOARD_HR_READ", "PAYSLIP_MANAGE", "SALARY_STRUCTURE_MANAGE"]'/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_at" valueDate="NOW()"/>
        </insert>

        <insert tableName="roles">
            <column name="name" value="ACADEMIC"/>
            <column name="description" value="Academic dashboard: grade distribution, GPA rollups, exam schedule"/>
            <column name="is_system_role" valueBoolean="true"/>
            <column name="permissions_json" value='["DASHBOARD_ACADEMIC_READ"]'/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_at" valueDate="NOW()"/>
        </insert>
    </changeSet>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Replaces exams.exam_type (a fixed UNIT_TEST/MIDTERM/FINAL/QUIZ enum column) with a
         tenant-defined exam-type catalog — see ExamTypeDefinition. Boards vary in exam
         categorization (e.g. Formative/Summative), so this follows the same tenant-catalog
         pattern as Board/Curriculum/GradingScale and pay_component_definitions. -->
    <changeSet id="school-049-exam-type-definitions" author="school">
        <createTable tableName="exam_type_definitions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="display_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_exam_type_definitions_tenant_id"
                baseTableName="exam_type_definitions" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>

        <createIndex indexName="idx_exam_type_definitions_tenant_id" tableName="exam_type_definitions">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_exam_type_definitions_deleted" tableName="exam_type_definitions">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="uq_exam_type_definitions_tenant_code" tableName="exam_type_definitions" unique="true">
            <column name="tenant_id"/>
            <column name="code"/>
        </createIndex>
    </changeSet>

    <!-- exam_type_id is left DB-nullable rather than adding a blocking NOT NULL constraint —
         MariaDB DDL is non-transactional, so retrofitting NOT NULL onto a column with any
         pre-existing row (e.g. local dev/test data predating this catalog) fails outright with no
         safe universal backfill value (unlike pay_component_definitions' JSON columns, a FK has
         no default row to point to). The real guarantee is enforced at the application layer:
         Exam.create() requires a non-null id and ExamService.schedule() validates it exists. -->
    <changeSet id="school-049-exams-exam-type-id" author="school">
        <addColumn tableName="exams">
            <column name="exam_type_id" type="BIGINT"/>
        </addColumn>
        <dropColumn tableName="exams" columnName="exam_type"/>
        <addForeignKeyConstraint
                constraintName="fk_exams_exam_type_id"
                baseTableName="exams" baseColumnNames="exam_type_id"
                referencedTableName="exam_type_definitions" referencedColumnNames="id"/>
        <createIndex indexName="idx_exams_exam_type_id" tableName="exams">
            <column name="exam_type_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Phase 2.1 — one append-only history spanning Admission → Enrollment → Alumni. Before
         enrollment only admission_id is set, the enrollment step sets both, afterwards only
         student_id (see LifecycleTransition). -->
    <changeSet id="school-145-lifecycle-transitions" author="school">
        <createTable tableName="lifecycle_transitions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="admission_id" type="BIGINT"/>
            <column name="student_id" type="BIGINT"/>
            <column name="from_stage" type="VARCHAR(20)"/>
            <column name="to_stage" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="effective_on" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="recorded_by_user_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_lifecycle_transitions_tenant_id"
                baseTableName="lifecycle_transitions" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_lifecycle_transitions_admission_id"
                baseTableName="lifecycle_transitions" baseColumnNames="admission_id"
                referencedTableName="admissions" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_lifecycle_transitions_student_id"
                baseTableName="lifecycle_transitions" baseColumnNames="student_id"
                referencedTableName="students" referencedColumnNames="id"/>
        <sql>
            ALTER TABLE lifecycle_transitions
            ADD CONSTRAINT chk_lifecycle_transitions_has_subject
            CHECK (admission_id IS NOT NULL OR student_id IS NOT NULL)
        </sql>

        <createIndex indexName="idx_lifecycle_transitions_tenant_student" tableName="lifecycle_transitions">
            <column name="tenant_id"/>
            <column name="student_id"/>
        </createIndex>
        <createIndex indexName="idx_lifecycle_transitions_tenant_admission" tableName="lifecycle_transitions">
            <column name="tenant_id"/>
            <column name="admission_id"/>
        </createIndex>
    </changeSet>

    <!-- Existing records get one synthetic row for the stage they are in today, so every timeline
         starts with a truthful current state instead of being empty. Skips admissions that were
         enrolled (their student's row covers that) and soft-deleted rows. -->
    <changeSet id="school-146-lifecycle-transitions-backfill" author="school">
        <sql>
            INSERT INTO lifecycle_transitions
                (public_id, version, tenant_id, student_id, to_stage, reason, effective_on, created_at, updated_at)
            SELECT UUID(), 0, s.tenant_id, s.id,
                   CASE s.enrollment_status WHEN 'ACTIVE' THEN 'ENROLLED' ELSE s.enrollment_status END,
                   'Recorded when lifecycle tracking was introduced',
                   DATE(COALESCE(s.enrollment_status_changed_at, s.created_at)), NOW(), NOW()
            FROM students s
            WHERE s.deleted = FALSE;
        </sql>
        <sql>
            INSERT INTO lifecycle_transitions
                (public_id, version, tenant_id, admission_id, to_stage, reason, effective_on, created_at, updated_at)
            SELECT UUID(), 0, a.tenant_id, a.id, a.status,
                   'Recorded when lifecycle tracking was introduced', DATE(a.submitted_at), NOW(), NOW()
            FROM admissions a
            WHERE a.deleted = FALSE AND a.status &lt;&gt; 'ENROLLED';
        </sql>
    </changeSet>

</databaseChangeLog>

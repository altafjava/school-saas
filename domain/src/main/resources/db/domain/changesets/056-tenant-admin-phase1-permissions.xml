<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Grants TENANT_ADMIN the Phase 1 permission codes introduced after
         045-tenant-admin-school-permissions.xml was written (STUDENT_DOCUMENT_READ/MANAGE,
         ID_CARD_ISSUE) — 045's own comment explains why TENANT_ADMIN's access is this explicit,
         auditable grant list rather than a blanket bypass; every new domain permission code needs
         its own such grant. Applied to every TENANT_ADMIN row (the tenant_id IS NULL global
         template AND any already-materialized per-tenant copies), not just the template, since
         RoleProvisioningListener only copies the template at tenant-creation time — an
         already-provisioned tenant's own copy would otherwise never see this update. -->
    <changeSet id="school-140-tenant-admin-phase1-permissions" author="school">
        <sql>
            UPDATE roles
            SET permissions_json = JSON_MERGE_PRESERVE(permissions_json,
                '["STUDENT_DOCUMENT_READ", "STUDENT_DOCUMENT_MANAGE", "ID_CARD_ISSUE"]')
            WHERE name = 'TENANT_ADMIN';
        </sql>
    </changeSet>

</databaseChangeLog>

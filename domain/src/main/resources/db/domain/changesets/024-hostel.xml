<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-072-hostel-buildings" author="school">
        <createTable tableName="hostel_buildings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="VARCHAR(500)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_hostel_buildings_tenant_id" tableName="hostel_buildings">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_hostel_buildings_deleted" tableName="hostel_buildings">
            <column name="deleted"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_hostel_buildings_tenant_id"
                baseTableName="hostel_buildings"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-073-hostel-rooms" author="school">
        <createTable tableName="hostel_rooms">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="hostel_building_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="room_number" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="capacity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_hostel_rooms_tenant_id" tableName="hostel_rooms">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_hostel_rooms_deleted" tableName="hostel_rooms">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_hostel_rooms_hostel_building_id" tableName="hostel_rooms">
            <column name="hostel_building_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_hostel_rooms_tenant_id"
                baseTableName="hostel_rooms"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_hostel_rooms_hostel_building_id"
                baseTableName="hostel_rooms"
                baseColumnNames="hostel_building_id"
                referencedTableName="hostel_buildings"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-074-room-allocations" author="school">
        <createTable tableName="room_allocations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="room_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="allocated_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="allocated_until" type="DATE"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_room_allocations_tenant_id" tableName="room_allocations">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_room_allocations_deleted" tableName="room_allocations">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_room_allocations_student_id" tableName="room_allocations">
            <column name="student_id"/>
        </createIndex>
        <createIndex indexName="idx_room_allocations_room_id" tableName="room_allocations">
            <column name="room_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_room_allocations_tenant_id"
                baseTableName="room_allocations"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_room_allocations_student_id"
                baseTableName="room_allocations"
                baseColumnNames="student_id"
                referencedTableName="students"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_room_allocations_room_id"
                baseTableName="room_allocations"
                baseColumnNames="room_id"
                referencedTableName="hostel_rooms"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Additive alongside the existing daily "attendance" table (school-006/002-school-extended-tables),
         not a replacement — period/subject/teacher context comes from timetable_entry_id (FK to
         timetable_entries) instead of duplicating those columns here. -->
    <changeSet id="school-065-period-attendance" author="school">
        <createTable tableName="period_attendance">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="classroom_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="timetable_entry_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="attendance_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="marked_by" type="VARCHAR(100)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE period_attendance
                ADD COLUMN active_attendance_date DATE
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN attendance_date ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="idx_period_attendance_tenant_id" tableName="period_attendance">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_period_attendance_deleted" tableName="period_attendance">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_period_attendance_student_date" tableName="period_attendance">
            <column name="student_id"/>
            <column name="attendance_date"/>
        </createIndex>
        <createIndex indexName="idx_period_attendance_classroom_date" tableName="period_attendance">
            <column name="classroom_id"/>
            <column name="attendance_date"/>
        </createIndex>
        <createIndex
                indexName="uq_period_attendance_student_entry_active_date_tenant"
                tableName="period_attendance"
                unique="true">
            <column name="student_id"/>
            <column name="timetable_entry_id"/>
            <column name="active_attendance_date"/>
            <column name="tenant_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_period_attendance_tenant_id"
                baseTableName="period_attendance"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_period_attendance_student_id"
                baseTableName="period_attendance"
                baseColumnNames="student_id"
                referencedTableName="students"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_period_attendance_classroom_id"
                baseTableName="period_attendance"
                baseColumnNames="classroom_id"
                referencedTableName="classrooms"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_period_attendance_timetable_entry_id"
                baseTableName="period_attendance"
                baseColumnNames="timetable_entry_id"
                referencedTableName="timetable_entries"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

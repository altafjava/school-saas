<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Phase 3.2 — a leave type can require the requester's department head to approve before an
         administrator gives the final approval. Every request freezes the number of approvals it
         needs at submission, and each decision is kept as an append-only trail. -->

    <changeSet id="school-161-leave-approval-levels" author="school">
        <addColumn tableName="leave_types">
            <column name="approval_levels" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>
            ALTER TABLE leave_types ADD CONSTRAINT chk_leave_types_approval_levels CHECK (approval_levels BETWEEN 1 AND 2)
        </sql>
        <addColumn tableName="leave_requests">
            <column name="approvals_required" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="approvals_granted" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>
            UPDATE leave_requests SET approvals_granted = 1 WHERE status = 'APPROVED'
        </sql>
        <sql>
            ALTER TABLE leave_requests ADD CONSTRAINT chk_leave_requests_approvals
            CHECK (approvals_required BETWEEN 1 AND 2 AND approvals_granted BETWEEN 0 AND approvals_required)
        </sql>
        <createIndex indexName="idx_leave_requests_tenant_status" tableName="leave_requests">
            <column name="tenant_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-162-leave-request-approvals" author="school">
        <createTable tableName="leave_request_approvals">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="leave_request_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="stage" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="decision" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="decided_by_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="decided_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="remarks" type="VARCHAR(500)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_leave_request_approvals_tenant_id"
                baseTableName="leave_request_approvals" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_leave_request_approvals_leave_request_id"
                baseTableName="leave_request_approvals" baseColumnNames="leave_request_id"
                referencedTableName="leave_requests" referencedColumnNames="id"/>
        <createIndex indexName="idx_leave_request_approvals_tenant_id" tableName="leave_request_approvals">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_leave_request_approvals_leave_request_id" tableName="leave_request_approvals">
            <column name="leave_request_id"/>
        </createIndex>
        <createIndex indexName="idx_leave_request_approvals_deleted" tableName="leave_request_approvals">
            <column name="deleted"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

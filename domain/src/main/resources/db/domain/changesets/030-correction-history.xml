<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Append-only correction/revision history for Grade, FeeStructure, and Attendance — see
         each entity's own Javadoc (GradeCorrection, FeeStructureRevision, AttendanceCorrection)
         for why: only updated_by/updated_at existed before, which shows a change happened but not
         what it was. -->
    <changeSet id="school-083-grade-corrections" author="school">
        <createTable tableName="grade_corrections">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="grade_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="old_marks" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="old_grade_letter" type="VARCHAR(5)">
                <constraints nullable="false"/>
            </column>
            <column name="new_marks" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="new_grade_letter" type="VARCHAR(5)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_grade_corrections_tenant_id" tableName="grade_corrections">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_grade_corrections_grade_id" tableName="grade_corrections">
            <column name="grade_id"/>
        </createIndex>
        <createIndex indexName="idx_grade_corrections_deleted" tableName="grade_corrections">
            <column name="deleted"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_grade_corrections_grade_id"
                baseTableName="grade_corrections"
                baseColumnNames="grade_id"
                referencedTableName="grades"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_grade_corrections_tenant_id"
                baseTableName="grade_corrections"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-084-fee-structure-revisions" author="school">
        <createTable tableName="fee_structure_revisions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="fee_structure_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="old_amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="new_amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_fee_structure_revisions_tenant_id" tableName="fee_structure_revisions">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_fee_structure_revisions_fee_structure_id" tableName="fee_structure_revisions">
            <column name="fee_structure_id"/>
        </createIndex>
        <createIndex indexName="idx_fee_structure_revisions_deleted" tableName="fee_structure_revisions">
            <column name="deleted"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_fee_structure_revisions_fee_structure_id"
                baseTableName="fee_structure_revisions"
                baseColumnNames="fee_structure_id"
                referencedTableName="fee_structures"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_fee_structure_revisions_tenant_id"
                baseTableName="fee_structure_revisions"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-085-attendance-corrections" author="school">
        <createTable tableName="attendance_corrections">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="attendance_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="old_status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="new_status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_attendance_corrections_tenant_id" tableName="attendance_corrections">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_attendance_corrections_attendance_id" tableName="attendance_corrections">
            <column name="attendance_id"/>
        </createIndex>
        <createIndex indexName="idx_attendance_corrections_deleted" tableName="attendance_corrections">
            <column name="deleted"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_attendance_corrections_attendance_id"
                baseTableName="attendance_corrections"
                baseColumnNames="attendance_id"
                referencedTableName="attendance"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_attendance_corrections_tenant_id"
                baseTableName="attendance_corrections"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

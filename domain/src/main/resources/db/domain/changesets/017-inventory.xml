<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-049-assets" author="school">
        <createTable tableName="assets">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="asset_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(100)"/>
            <column name="purchase_date" type="DATE"/>
            <column name="purchase_cost" type="DECIMAL(12,2)"/>
            <column name="location" type="VARCHAR(150)"/>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE assets
                ADD COLUMN active_asset_code VARCHAR(50)
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN asset_code ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="idx_assets_tenant_id" tableName="assets">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_assets_deleted" tableName="assets">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="uq_assets_tenant_active_code" tableName="assets" unique="true">
            <column name="tenant_id"/>
            <column name="active_asset_code"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_assets_tenant_id"
                baseTableName="assets"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-050-asset-assignments" author="school">
        <createTable tableName="asset_assignments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="asset_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_to_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_at" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="returned_at" type="DATE"/>
            <column name="assigned_to_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_asset_assignments_tenant_id" tableName="asset_assignments">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_asset_assignments_deleted" tableName="asset_assignments">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_asset_assignments_asset_id" tableName="asset_assignments">
            <column name="asset_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_asset_assignments_tenant_id"
                baseTableName="asset_assignments"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_asset_assignments_asset_id"
                baseTableName="asset_assignments"
                baseColumnNames="asset_id"
                referencedTableName="assets"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

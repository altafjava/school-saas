<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Phase 2.2 — Employee as the HR master record, Teacher as its teaching subtype.

         Every teacher's HR data moves to `employees`, keeping the SAME id (so every FK to
         teachers.id — classrooms, timetable, lessons, ... — stays valid untouched) and public id.
         `teachers` keeps only its id, now a FK to employees.id. Leave, payroll and departments are
         HR concerns, not teaching ones, so they are re-pointed at employees (non-teaching staff can
         then have leave and payslips too). -->

    <changeSet id="school-153-create-employees" author="school">
        <createTable tableName="employees">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="employee_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(30)"/>
            <column name="address_line1" type="VARCHAR(255)"/>
            <column name="address_line2" type="VARCHAR(255)"/>
            <column name="address_locality" type="VARCHAR(100)"/>
            <column name="address_region" type="VARCHAR(100)"/>
            <column name="address_postal_code" type="VARCHAR(20)"/>
            <column name="address_country_code" type="VARCHAR(2)"/>
            <column name="join_date" type="DATE"/>
            <column name="user_id" type="BIGINT"/>
            <column name="department_id" type="BIGINT"/>
            <column name="designation" type="VARCHAR(100)"/>
            <column name="qualification" type="VARCHAR(255)"/>
            <column name="employment_type" type="VARCHAR(30)"/>
            <column name="staff_category" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="probation_end_date" type="DATE"/>
            <column name="exit_date" type="DATE"/>
            <column name="exit_reason" type="VARCHAR(500)"/>
            <column name="photo_file_public_id" type="UUID"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>
    </changeSet>

    <changeSet id="school-154-copy-teachers-into-employees" author="school">
        <sql>
            INSERT INTO employees
                (id, public_id, version, tenant_id, employee_code, first_name, last_name, email, phone,
                 address_line1, address_line2, address_locality, address_region, address_postal_code,
                 address_country_code, join_date, user_id, department_id, qualification, employment_type,
                 staff_category, status, probation_end_date, photo_file_public_id,
                 deleted, deleted_at, deleted_by, created_at, updated_at, created_by, updated_by)
            SELECT id, public_id, version, tenant_id, employee_code, first_name, last_name, email, phone,
                   address_line1, address_line2, address_locality, address_region, address_postal_code,
                   address_country_code, join_date, user_id, department_id, qualification, employment_type,
                   'TEACHING', 'ACTIVE', probation_end_date, photo_file_public_id,
                   deleted, deleted_at, deleted_by, created_at, updated_at, created_by, updated_by
            FROM teachers
        </sql>
    </changeSet>

    <changeSet id="school-155-employees-constraints" author="school">
        <addForeignKeyConstraint constraintName="fk_employees_tenant_id"
                baseTableName="employees" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_employees_user_id"
                baseTableName="employees" baseColumnNames="user_id"
                referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_employees_department_id"
                baseTableName="employees" baseColumnNames="department_id"
                referencedTableName="departments" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_employees_photo_file_public_id"
                baseTableName="employees" baseColumnNames="photo_file_public_id"
                referencedTableName="file_metadata" referencedColumnNames="public_id"/>
        <sql>
            ALTER TABLE employees ADD CONSTRAINT chk_employees_exit_consistency
            CHECK ((status = 'ACTIVE' AND exit_date IS NULL) OR (status &lt;&gt; 'ACTIVE' AND exit_date IS NOT NULL))
        </sql>
        <!-- Soft-delete-safe unique employee code, same technique as 052. -->
        <sql>
            ALTER TABLE employees
            ADD COLUMN active_employee_code VARCHAR(50)
            GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN employee_code ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="uq_employees_active_employee_code_tenant" tableName="employees" unique="true">
            <column name="active_employee_code"/>
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_employees_tenant_id" tableName="employees">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_employees_deleted" tableName="employees">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_employees_user_id" tableName="employees">
            <column name="user_id"/>
        </createIndex>
        <createIndex indexName="idx_employees_department_id" tableName="employees">
            <column name="department_id"/>
        </createIndex>
        <createIndex indexName="idx_employees_tenant_category_status" tableName="employees">
            <column name="tenant_id"/>
            <column name="staff_category"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-156-slim-teachers-to-a-subtype" author="school">
        <dropForeignKeyConstraint baseTableName="teachers" constraintName="fk_teachers_department_id"/>
        <dropForeignKeyConstraint baseTableName="teachers" constraintName="fk_teachers_tenant_id"/>
        <dropForeignKeyConstraint baseTableName="teachers" constraintName="fk_teachers_user_id"/>
        <dropForeignKeyConstraint baseTableName="teachers" constraintName="fk_teachers_photo_file_public_id"/>
        <dropIndex tableName="teachers" indexName="uq_teachers_active_employee_code_tenant"/>
        <dropIndex tableName="teachers" indexName="idx_teachers_tenant_id"/>
        <dropIndex tableName="teachers" indexName="idx_teachers_deleted"/>
        <dropIndex tableName="teachers" indexName="idx_teachers_user_id"/>
        <dropIndex tableName="teachers" indexName="idx_teachers_department_id"/>
        <dropColumn tableName="teachers">
            <column name="active_employee_code"/>
            <column name="public_id"/>
            <column name="version"/>
            <column name="tenant_id"/>
            <column name="employee_code"/>
            <column name="first_name"/>
            <column name="last_name"/>
            <column name="email"/>
            <column name="join_date"/>
            <column name="user_id"/>
            <column name="deleted"/>
            <column name="deleted_at"/>
            <column name="deleted_by"/>
            <column name="created_at"/>
            <column name="updated_at"/>
            <column name="created_by"/>
            <column name="updated_by"/>
            <column name="department_id"/>
            <column name="qualification"/>
            <column name="employment_type"/>
            <column name="phone"/>
            <column name="address_line1"/>
            <column name="address_line2"/>
            <column name="address_locality"/>
            <column name="address_region"/>
            <column name="address_postal_code"/>
            <column name="address_country_code"/>
            <column name="probation_end_date"/>
            <column name="photo_file_public_id"/>
        </dropColumn>
        <!-- The id is now assigned by employees, not auto-generated here. -->
        <sql>ALTER TABLE teachers MODIFY id BIGINT NOT NULL</sql>
        <addForeignKeyConstraint constraintName="fk_teachers_employee_id"
                baseTableName="teachers" baseColumnNames="id"
                referencedTableName="employees" referencedColumnNames="id"/>
    </changeSet>

    <!-- HR tables follow the employee, not the teaching role. Each step order matters: drop the FK,
         rename the column and its indexes, then add the new FK (an FK pins its index). -->
    <changeSet id="school-157-hr-tables-reference-employees" author="school">
        <dropForeignKeyConstraint baseTableName="leave_balances" constraintName="fk_leave_balances_teacher_id"/>
        <dropForeignKeyConstraint baseTableName="leave_requests" constraintName="fk_leave_requests_teacher_id"/>
        <dropForeignKeyConstraint baseTableName="salary_structures" constraintName="fk_salary_structures_teacher_id"/>
        <dropForeignKeyConstraint baseTableName="payslips" constraintName="fk_payslips_teacher_id"/>
        <dropForeignKeyConstraint baseTableName="departments" constraintName="fk_departments_head_teacher_id"/>

        <renameColumn tableName="leave_balances" oldColumnName="teacher_id" newColumnName="employee_id" columnDataType="BIGINT"/>
        <renameColumn tableName="leave_requests" oldColumnName="teacher_id" newColumnName="employee_id" columnDataType="BIGINT"/>
        <renameColumn tableName="salary_structures" oldColumnName="teacher_id" newColumnName="employee_id" columnDataType="BIGINT"/>
        <renameColumn tableName="payslips" oldColumnName="teacher_id" newColumnName="employee_id" columnDataType="BIGINT"/>
        <renameColumn tableName="departments" oldColumnName="head_teacher_id" newColumnName="head_employee_id" columnDataType="BIGINT"/>

        <sql>
            ALTER TABLE leave_balances RENAME INDEX idx_leave_balances_teacher_id TO idx_leave_balances_employee_id;
            ALTER TABLE leave_balances RENAME INDEX uq_leave_balances_teacher_type_active_year TO uq_leave_balances_employee_type_active_year;
            ALTER TABLE leave_requests RENAME INDEX idx_leave_requests_teacher_id TO idx_leave_requests_employee_id;
            ALTER TABLE salary_structures RENAME INDEX idx_salary_structures_teacher_id TO idx_salary_structures_employee_id;
            ALTER TABLE payslips RENAME INDEX idx_payslips_teacher_id TO idx_payslips_employee_id;
            ALTER TABLE payslips RENAME INDEX uq_payslips_teacher_year_active_month TO uq_payslips_employee_year_active_month;
            ALTER TABLE departments RENAME INDEX idx_departments_head_teacher_id TO idx_departments_head_employee_id;
        </sql>

        <addForeignKeyConstraint constraintName="fk_leave_balances_employee_id"
                baseTableName="leave_balances" baseColumnNames="employee_id"
                referencedTableName="employees" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_leave_requests_employee_id"
                baseTableName="leave_requests" baseColumnNames="employee_id"
                referencedTableName="employees" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_salary_structures_employee_id"
                baseTableName="salary_structures" baseColumnNames="employee_id"
                referencedTableName="employees" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_payslips_employee_id"
                baseTableName="payslips" baseColumnNames="employee_id"
                referencedTableName="employees" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_departments_head_employee_id"
                baseTableName="departments" baseColumnNames="head_employee_id"
                referencedTableName="employees" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

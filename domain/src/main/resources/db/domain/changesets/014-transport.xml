<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-042-vehicles" author="school">
        <createTable tableName="vehicles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="registration_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="capacity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="driver_name" type="VARCHAR(100)"/>
            <column name="driver_contact" type="VARCHAR(50)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE vehicles
                ADD COLUMN active_registration_number VARCHAR(50)
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN registration_number ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="idx_vehicles_tenant_id" tableName="vehicles">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_vehicles_deleted" tableName="vehicles">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="uq_vehicles_tenant_active_registration" tableName="vehicles" unique="true">
            <column name="tenant_id"/>
            <column name="active_registration_number"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_vehicles_tenant_id"
                baseTableName="vehicles"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-043-routes" author="school">
        <createTable tableName="routes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE routes
                ADD COLUMN active_code VARCHAR(50)
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN code ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="idx_routes_tenant_id" tableName="routes">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_routes_deleted" tableName="routes">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="uq_routes_tenant_active_code" tableName="routes" unique="true">
            <column name="tenant_id"/>
            <column name="active_code"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_routes_tenant_id"
                baseTableName="routes"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-044-route-stops" author="school">
        <createTable tableName="route_stops">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="route_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="stop_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="sequence_order" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="pickup_time" type="TIME"/>
            <column name="drop_time" type="TIME"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_route_stops_tenant_id" tableName="route_stops">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_route_stops_deleted" tableName="route_stops">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_route_stops_route_id" tableName="route_stops">
            <column name="route_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_route_stops_tenant_id"
                baseTableName="route_stops"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_route_stops_route_id"
                baseTableName="route_stops"
                baseColumnNames="route_id"
                referencedTableName="routes"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-045-transport-assignments" author="school">
        <createTable tableName="transport_assignments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="route_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="vehicle_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="route_stop_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="effective_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="effective_to" type="DATE"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_transport_assignments_tenant_id" tableName="transport_assignments">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_transport_assignments_deleted" tableName="transport_assignments">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_transport_assignments_student_id" tableName="transport_assignments">
            <column name="student_id"/>
        </createIndex>
        <createIndex indexName="idx_transport_assignments_route_id" tableName="transport_assignments">
            <column name="route_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_transport_assignments_tenant_id"
                baseTableName="transport_assignments"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_transport_assignments_student_id"
                baseTableName="transport_assignments"
                baseColumnNames="student_id"
                referencedTableName="students"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_transport_assignments_route_id"
                baseTableName="transport_assignments"
                baseColumnNames="route_id"
                referencedTableName="routes"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_transport_assignments_vehicle_id"
                baseTableName="transport_assignments"
                baseColumnNames="vehicle_id"
                referencedTableName="vehicles"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_transport_assignments_route_stop_id"
                baseTableName="transport_assignments"
                baseColumnNames="route_stop_id"
                referencedTableName="route_stops"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

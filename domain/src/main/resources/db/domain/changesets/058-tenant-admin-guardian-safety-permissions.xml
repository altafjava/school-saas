<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Grants TENANT_ADMIN the Phase 2.5 permission codes — same explicit-grant rationale, and the
         same "every TENANT_ADMIN row, template and materialized copies" scope, as
         056-tenant-admin-phase1-permissions.xml. -->
    <changeSet id="school-144-tenant-admin-guardian-safety-permissions" author="school">
        <sql>
            UPDATE roles
            SET permissions_json = JSON_MERGE_PRESERVE(permissions_json,
                '["GUARDIAN_PICKUP_MANAGE", "GUARDIAN_PICKUP_READ", "EMERGENCY_CONTACT_MANAGE"]')
            WHERE name = 'TENANT_ADMIN';
        </sql>
    </changeSet>

</databaseChangeLog>

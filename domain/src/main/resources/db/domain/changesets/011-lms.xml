<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-028-lessons" author="school">
        <createTable tableName="lessons">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="classroom_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="subject_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="teacher_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="CLOB"/>
            <column name="storage_key" type="VARCHAR(500)"/>
            <column name="posted_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_lesson_tenant_id" tableName="lessons">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_lesson_deleted" tableName="lessons">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_lesson_classroom_id" tableName="lessons">
            <column name="classroom_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_lesson_tenant_id"
                baseTableName="lessons"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_lesson_classroom_id"
                baseTableName="lessons"
                baseColumnNames="classroom_id"
                referencedTableName="classrooms"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_lesson_subject_id"
                baseTableName="lessons"
                baseColumnNames="subject_id"
                referencedTableName="subjects"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_lesson_teacher_id"
                baseTableName="lessons"
                baseColumnNames="teacher_id"
                referencedTableName="teachers"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-029-assignments" author="school">
        <createTable tableName="assignments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="classroom_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="subject_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="teacher_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="CLOB"/>
            <column name="storage_key" type="VARCHAR(500)"/>
            <column name="due_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="max_marks" type="DECIMAL(10,2)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_assignment_tenant_id" tableName="assignments">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_assignment_deleted" tableName="assignments">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_assignment_classroom_id" tableName="assignments">
            <column name="classroom_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_assignment_tenant_id"
                baseTableName="assignments"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_assignment_classroom_id"
                baseTableName="assignments"
                baseColumnNames="classroom_id"
                referencedTableName="classrooms"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_assignment_subject_id"
                baseTableName="assignments"
                baseColumnNames="subject_id"
                referencedTableName="subjects"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_assignment_teacher_id"
                baseTableName="assignments"
                baseColumnNames="teacher_id"
                referencedTableName="teachers"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-030-submissions" author="school">
        <createTable tableName="submissions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="assignment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="graded_by" type="BIGINT"/>
            <column name="submitted_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="storage_key" type="VARCHAR(500)"/>
            <column name="text_content" type="CLOB"/>
            <column name="marks_obtained" type="DECIMAL(10,2)"/>
            <column name="feedback" type="CLOB"/>
            <column name="graded_at" type="TIMESTAMP"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE submissions
                ADD COLUMN active_student_id BIGINT
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN student_id ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="idx_submission_tenant_id" tableName="submissions">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_submission_deleted" tableName="submissions">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_submission_assignment_id" tableName="submissions">
            <column name="assignment_id"/>
        </createIndex>
        <createIndex indexName="uq_submission_tenant_assignment_active_student" tableName="submissions" unique="true">
            <column name="tenant_id"/>
            <column name="assignment_id"/>
            <column name="active_student_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_submission_tenant_id"
                baseTableName="submissions"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_submission_assignment_id"
                baseTableName="submissions"
                baseColumnNames="assignment_id"
                referencedTableName="assignments"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_submission_student_id"
                baseTableName="submissions"
                baseColumnNames="student_id"
                referencedTableName="students"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_submission_graded_by"
                baseTableName="submissions"
                baseColumnNames="graded_by"
                referencedTableName="teachers"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

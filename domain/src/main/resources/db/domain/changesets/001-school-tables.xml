<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-001-teachers" author="school">
        <createTable tableName="teachers">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="school-002-classrooms" author="school">
        <createTable tableName="classrooms">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="class_teacher_id" type="BIGINT"/>
            <column name="academic_year_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="curriculum_id" type="BIGINT"/>
            <column name="class_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="grade" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="section" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="academic_year" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="capacity" type="INT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE classrooms
                ADD COLUMN active_class_code VARCHAR(50)
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN class_code ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="idx_classrooms_tenant_id" tableName="classrooms">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_classrooms_deleted" tableName="classrooms">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_classrooms_class_teacher_id" tableName="classrooms">
            <column name="class_teacher_id"/>
        </createIndex>
        <createIndex indexName="idx_classrooms_academic_year_id" tableName="classrooms">
            <column name="academic_year_id"/>
        </createIndex>
        <createIndex indexName="idx_classrooms_curriculum_id" tableName="classrooms">
            <column name="curriculum_id"/>
        </createIndex>
        <createIndex indexName="uq_classrooms_active_code_tenant" tableName="classrooms" unique="true">
            <column name="active_class_code"/>
            <column name="tenant_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_classrooms_tenant_id"
                baseTableName="classrooms"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_classrooms_class_teacher_id"
                baseTableName="classrooms"
                baseColumnNames="class_teacher_id"
                referencedTableName="teachers"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-003-students" author="school">
        <createTable tableName="students">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT"/>
            <!-- References file_metadata.public_id (unique), never its surrogate id. -->
            <column name="photo_file_public_id" type="UUID"/>
            <column name="sibling_group_id" type="BIGINT"/>
            <column name="student_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="date_of_birth" type="DATE"/>
            <column name="phone" type="VARCHAR(30)"/>
            <column name="address_line1" type="VARCHAR(255)"/>
            <column name="address_line2" type="VARCHAR(255)"/>
            <column name="address_locality" type="VARCHAR(100)"/>
            <column name="address_region" type="VARCHAR(100)"/>
            <column name="address_postal_code" type="VARCHAR(20)"/>
            <column name="address_country_code" type="VARCHAR(2)"/>
            <column name="enrollment_status_changed_at" type="TIMESTAMP"/>
            <column name="enrollment_status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE students
                ADD COLUMN active_student_code VARCHAR(50)
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN student_code ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="idx_students_tenant_id" tableName="students">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_students_deleted" tableName="students">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_students_user_id" tableName="students">
            <column name="user_id"/>
        </createIndex>
        <createIndex indexName="uq_students_active_code_tenant" tableName="students" unique="true">
            <column name="active_student_code"/>
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_students_tenant_sibling_group" tableName="students">
            <column name="tenant_id"/>
            <column name="sibling_group_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_students_tenant_id"
                baseTableName="students"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_students_user_id"
                baseTableName="students"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_students_photo_file_public_id"
                baseTableName="students"
                baseColumnNames="photo_file_public_id"
                referencedTableName="file_metadata"
                referencedColumnNames="public_id"/>
    </changeSet>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-023-student-classroom-links" author="school">
        <createTable tableName="student_classroom_links">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="classroom_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="academic_year_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="enrolled_at" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="roll_number" type="VARCHAR(20)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE student_classroom_links
                ADD COLUMN active_academic_year_id BIGINT
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN academic_year_id ELSE NULL END) VIRTUAL;
        </sql>
        <sql>
            ALTER TABLE student_classroom_links
                ADD COLUMN active_roll_number VARCHAR(20)
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN roll_number ELSE NULL END) VIRTUAL;
        </sql>
        <createIndex indexName="idx_scl_tenant_id" tableName="student_classroom_links">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_scl_deleted" tableName="student_classroom_links">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_scl_student_id" tableName="student_classroom_links">
            <column name="student_id"/>
        </createIndex>
        <createIndex indexName="idx_scl_classroom_id" tableName="student_classroom_links">
            <column name="classroom_id"/>
        </createIndex>
        <createIndex indexName="uq_scl_student_active_academic_year" tableName="student_classroom_links" unique="true">
            <column name="student_id"/>
            <column name="active_academic_year_id"/>
        </createIndex>
        <createIndex
                indexName="uq_scl_classroom_year_active_roll_number"
                tableName="student_classroom_links"
                unique="true">
            <column name="classroom_id"/>
            <column name="academic_year_id"/>
            <column name="active_roll_number"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_scl_tenant_id"
                baseTableName="student_classroom_links"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_scl_student_id"
                baseTableName="student_classroom_links"
                baseColumnNames="student_id"
                referencedTableName="students"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_scl_classroom_id"
                baseTableName="student_classroom_links"
                baseColumnNames="classroom_id"
                referencedTableName="classrooms"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_scl_academic_year_id"
                baseTableName="student_classroom_links"
                baseColumnNames="academic_year_id"
                referencedTableName="academic_years"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-075-health-records" author="school">
        <createTable tableName="health_records">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="blood_group" type="VARCHAR(10)"/>
            <column name="allergies" type="VARCHAR(1000)"/>
            <column name="conditions" type="VARCHAR(1000)"/>
            <column name="immunizations" type="VARCHAR(1000)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE health_records
                ADD COLUMN active_student_id BIGINT
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN student_id ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="idx_health_records_tenant_id" tableName="health_records">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_health_records_deleted" tableName="health_records">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="uq_health_records_active_student" tableName="health_records" unique="true">
            <column name="tenant_id"/>
            <column name="active_student_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_health_records_tenant_id"
                baseTableName="health_records"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_health_records_student_id"
                baseTableName="health_records"
                baseColumnNames="student_id"
                referencedTableName="students"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-076-medical-incidents" author="school">
        <createTable tableName="medical_incidents">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="treatment_given" type="VARCHAR(1000)"/>
            <column name="guardian_notified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="recorded_by_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_medical_incidents_tenant_id" tableName="medical_incidents">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_medical_incidents_deleted" tableName="medical_incidents">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_medical_incidents_student_id" tableName="medical_incidents">
            <column name="student_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_medical_incidents_tenant_id"
                baseTableName="medical_incidents"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_medical_incidents_student_id"
                baseTableName="medical_incidents"
                baseColumnNames="student_id"
                referencedTableName="students"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

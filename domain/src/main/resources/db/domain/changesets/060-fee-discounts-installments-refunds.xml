<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Phase 2.4 — fee discounts, installment plans and refunds. -->

    <changeSet id="school-147-fee-discounts" author="school">
        <createTable tableName="fee_discounts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="fee_structure_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="discount_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="discount_value" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="granted_by_user_id" type="BIGINT"/>
            <column name="revoked_at" type="TIMESTAMP"/>
            <column name="revocation_reason" type="VARCHAR(500)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_fee_discounts_tenant_id"
                baseTableName="fee_discounts" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_fee_discounts_student_id"
                baseTableName="fee_discounts" baseColumnNames="student_id"
                referencedTableName="students" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_fee_discounts_fee_structure_id"
                baseTableName="fee_discounts" baseColumnNames="fee_structure_id"
                referencedTableName="fee_structures" referencedColumnNames="id"/>
        <sql>
            ALTER TABLE fee_discounts ADD CONSTRAINT chk_fee_discounts_value_positive
            CHECK (discount_value &gt; 0)
        </sql>
        <createIndex indexName="idx_fee_discounts_tenant_student" tableName="fee_discounts">
            <column name="tenant_id"/>
            <column name="student_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-148-fee-installments" author="school">
        <createTable tableName="fee_installments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="fee_structure_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="sequence_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="due_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="share_basis_points" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_fee_installments_tenant_id"
                baseTableName="fee_installments" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_fee_installments_student_id"
                baseTableName="fee_installments" baseColumnNames="student_id"
                referencedTableName="students" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_fee_installments_fee_structure_id"
                baseTableName="fee_installments" baseColumnNames="fee_structure_id"
                referencedTableName="fee_structures" referencedColumnNames="id"/>
        <sql>
            ALTER TABLE fee_installments ADD CONSTRAINT chk_fee_installments_share
            CHECK (share_basis_points BETWEEN 1 AND 10000)
        </sql>
        <!-- One live installment per (student, structure, position); a replaced plan is soft-deleted
             and its numbers can be reused (soft-delete-safe generated column, as in 052). -->
        <sql>
            ALTER TABLE fee_installments
            ADD COLUMN active_sequence_number INT
            GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN sequence_number ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="uq_fee_installments_active_position" tableName="fee_installments" unique="true">
            <column name="tenant_id"/>
            <column name="student_id"/>
            <column name="fee_structure_id"/>
            <column name="active_sequence_number"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-149-fee-refunds" author="school">
        <createTable tableName="fee_refunds">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="fee_payment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="fee_structure_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="method" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="credit_note_number" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="gateway_refund_reference" type="VARCHAR(255)"/>
            <column name="failure_reason" type="VARCHAR(500)"/>
            <column name="refunded_by_user_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_fee_refunds_tenant_id"
                baseTableName="fee_refunds" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_fee_refunds_fee_payment_id"
                baseTableName="fee_refunds" baseColumnNames="fee_payment_id"
                referencedTableName="fee_payments" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_fee_refunds_student_id"
                baseTableName="fee_refunds" baseColumnNames="student_id"
                referencedTableName="students" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_fee_refunds_fee_structure_id"
                baseTableName="fee_refunds" baseColumnNames="fee_structure_id"
                referencedTableName="fee_structures" referencedColumnNames="id"/>
        <sql>
            ALTER TABLE fee_refunds ADD CONSTRAINT chk_fee_refunds_amount_positive CHECK (amount &gt; 0)
        </sql>
        <createIndex indexName="uq_fee_refunds_tenant_credit_note" tableName="fee_refunds" unique="true">
            <column name="tenant_id"/>
            <column name="credit_note_number"/>
        </createIndex>
        <createIndex indexName="idx_fee_refunds_tenant_payment" tableName="fee_refunds">
            <column name="tenant_id"/>
            <column name="fee_payment_id"/>
        </createIndex>
        <createIndex indexName="idx_fee_refunds_tenant_student" tableName="fee_refunds">
            <column name="tenant_id"/>
            <column name="student_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

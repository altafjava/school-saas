    <changeSet id="school-122-report-card-templates-soft-delete-unique-fix" author="school">
        <!-- Single-column key (one active template per tenant) — same pattern as platform-saas's
             subscriptions fix (035-addon-purchase-race-fixes.xml), not a composite key.
             uq_report_card_templates_tenant_id is also the only index covering the
             fk_report_card_templates_tenant_id foreign key (044-report-card-template-remarks.xml
             never added a separate plain index, since the unique one already covered it) — a plain
             index is added first so MariaDB still has one to back the FK once the unique index is
             dropped. -->
        <createIndex indexName="idx_report_card_templates_tenant_id" tableName="report_card_templates">
            <column name="tenant_id"/>
        </createIndex>
        <dropIndex indexName="uq_report_card_templates_tenant_id" tableName="report_card_templates"/>
        <sql>
            ALTER TABLE report_card_templates
            ADD COLUMN active_tenant_key BIGINT

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!--
        Generalizes 051's fix (student_classroom_links) across every other unique index in this
        schema that has the same soft-delete interaction bug: a plain UNIQUE constraint counts
        soft-deleted rows too, so withdrawing/removing a row and later creating a new one with the
        same natural key collides with the old, soft-deleted row. Each changeset below adds one
        generated column — the same value as one of the original key's columns, but NULL whenever
        the row is soft-deleted — and rebuilds the unique index on that column instead. MariaDB (and
        SQL generally) never treats two NULLs as equal in a unique index, so any number of
        soft-deleted rows can coexist; only the single live row per key is still enforced unique.
        Nulling any one column of a composite key is sufficient to fix the whole index, since a NULL
        in any position removes that row from uniqueness comparison entirely — the other columns are
        kept unchanged for indexing/lookup value.

        Tables confirmed NOT affected and intentionally excluded: guardian_consent_records
        (GuardianConsentRecord extends TenantEntity directly, not SoftDeletableEntity — an
        immutable GDPR/DPDP consent record by design).
    -->

    <changeSet id="school-096-payslips-soft-delete-unique-fix" author="school">
        <dropIndex indexName="uq_payslips_teacher_year_month" tableName="payslips"/>
        <sql>
            ALTER TABLE payslips
            ADD COLUMN active_pay_month INT
            GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN pay_month ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="uq_payslips_teacher_year_active_month" tableName="payslips" unique="true">
            <column name="teacher_id"/>
            <column name="pay_year"/>
            <column name="active_pay_month"/>
        </createIndex>
    </changeSet>


<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Phase 3.1 — an exam's weight in its subject's term result, and the gate that keeps results
         invisible to students and guardians until the school publishes them. Existing exams
         default to full weight and count as already published, so no student loses sight of a
         result they could see before. -->

    <changeSet id="school-159-exam-weightage-and-result-publication" author="school">
        <addColumn tableName="exams">
            <column name="weightage" type="DECIMAL(5,2)" defaultValueNumeric="100">
                <constraints nullable="false"/>
            </column>
            <column name="results_published_at" type="TIMESTAMP"/>
            <column name="results_published_by" type="VARCHAR(100)"/>
        </addColumn>
        <sql>
            ALTER TABLE exams ADD CONSTRAINT chk_exams_weightage CHECK (weightage > 0 AND weightage &lt;= 100)
        </sql>
        <sql>
            UPDATE exams SET results_published_at = updated_at, results_published_by = 'migration'
            WHERE status = 'COMPLETED'
        </sql>
        <createIndex indexName="idx_exams_tenant_classroom_subject_term" tableName="exams">
            <column name="tenant_id"/>
            <column name="classroom_id"/>
            <column name="subject_id"/>
            <column name="term_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-160-exam-result-publish-permission" author="school">
        <sql>
            UPDATE roles
            SET permissions_json = JSON_MERGE_PRESERVE(permissions_json, '["EXAM_RESULT_PUBLISH"]')
            WHERE name IN ('TENANT_ADMIN', 'PRINCIPAL', 'ACADEMIC');
        </sql>
    </changeSet>

</databaseChangeLog>

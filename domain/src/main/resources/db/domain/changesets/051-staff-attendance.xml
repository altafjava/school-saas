<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-200-staff-attendance" author="school">
        <createTable tableName="staff_attendance">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="attendance_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="check_in_at" type="TIMESTAMP"/>
            <column name="check_out_at" type="TIMESTAMP"/>
            <column name="late" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="left_early" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="VARCHAR(500)"/>
            <column name="marked_by" type="VARCHAR(100)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="deleted_token" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_staff_attendance_employee"
                baseTableName="staff_attendance" baseColumnNames="employee_id"
                referencedTableName="employees" referencedColumnNames="id"/>
        <createIndex indexName="idx_staff_attendance_tenant_id" tableName="staff_attendance">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_staff_attendance_employee_id" tableName="staff_attendance">
            <column name="employee_id"/>
        </createIndex>
        <createIndex indexName="idx_staff_attendance_status" tableName="staff_attendance">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_staff_attendance_deleted" tableName="staff_attendance">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_staff_attendance_created_at" tableName="staff_attendance">
            <column name="created_at"/>
        </createIndex>
        <createIndex indexName="idx_staff_attendance_attendance_date" tableName="staff_attendance">
            <column name="attendance_date"/>
        </createIndex>
        <createIndex indexName="uq_staff_attendance_employee_date" tableName="staff_attendance" unique="true">
            <column name="tenant_id"/>
            <column name="employee_id"/>
            <column name="attendance_date"/>
            <column name="deleted_token"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

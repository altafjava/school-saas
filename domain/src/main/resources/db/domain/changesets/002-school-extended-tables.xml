            </column>
            <column name="weightage" type="DECIMAL(5,2)" defaultValueNumeric="100">
                <constraints nullable="false"/>
            </column>
            <column name="results_published_at" type="TIMESTAMP"/>
            <column name="results_published_by" type="VARCHAR(100)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE exams ADD CONSTRAINT chk_exams_weightage CHECK (weightage &gt; 0 AND weightage &lt;= 100);
        </sql>
        <createIndex indexName="idx_exams_tenant_id" tableName="exams">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_exams_deleted" tableName="exams">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_exams_classroom_id" tableName="exams">
            <column name="classroom_id"/>
        </createIndex>
        <createIndex indexName="idx_exams_subject_id" tableName="exams">
            <column name="subject_id"/>
        </createIndex>
        <createIndex indexName="idx_exams_scheduled_at" tableName="exams">
            <column name="scheduled_at"/>
        </createIndex>
        <createIndex indexName="idx_exams_term_id" tableName="exams">
            <column name="term_id"/>
        </createIndex>
        <createIndex indexName="idx_exams_exam_type_id" tableName="exams">
            <column name="exam_type_id"/>
        </createIndex>
        <createIndex indexName="idx_exams_tenant_classroom_subject_term" tableName="exams">
            <column name="tenant_id"/>
            <column name="classroom_id"/>
            <column name="subject_id"/>
            <column name="term_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_exams_tenant_id"
                baseTableName="exams"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_exams_classroom_id"

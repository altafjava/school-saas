<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-046-discipline-incidents" author="school">
        <createTable tableName="discipline_incidents">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="reported_by_teacher_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="incident_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="severity" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="action_taken" type="VARCHAR(1000)"/>
            <column name="guardian_notified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_discipline_incidents_tenant_id" tableName="discipline_incidents">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_discipline_incidents_deleted" tableName="discipline_incidents">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_discipline_incidents_student_id" tableName="discipline_incidents">
            <column name="student_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_discipline_incidents_tenant_id"
                baseTableName="discipline_incidents"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_discipline_incidents_student_id"
                baseTableName="discipline_incidents"
                baseColumnNames="student_id"
                referencedTableName="students"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_discipline_incidents_teacher_id"
                baseTableName="discipline_incidents"
                baseColumnNames="reported_by_teacher_id"
                referencedTableName="teachers"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-180-student-leave-requests" author="school">
        <createTable tableName="student_leave_requests">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="classroom_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="requested_by_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="decided_by_user_id" type="BIGINT"/>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="attachment_file_public_id" type="UUID"/>
            <column name="decided_at" type="TIMESTAMP"/>
            <column name="rejection_reason" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="deleted_token" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_student_leave_requests_student"
                baseTableName="student_leave_requests" baseColumnNames="student_id"
                referencedTableName="students" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_student_leave_requests_classroom"
                baseTableName="student_leave_requests" baseColumnNames="classroom_id"
                referencedTableName="classrooms" referencedColumnNames="id"/>
        <createIndex indexName="idx_student_leave_requests_tenant_id" tableName="student_leave_requests">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_student_leave_requests_student_id" tableName="student_leave_requests">
            <column name="student_id"/>
        </createIndex>
        <createIndex indexName="idx_student_leave_requests_classroom_id" tableName="student_leave_requests">
            <column name="classroom_id"/>
        </createIndex>
        <createIndex indexName="idx_student_leave_requests_status" tableName="student_leave_requests">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_student_leave_requests_deleted" tableName="student_leave_requests">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_student_leave_requests_created_at" tableName="student_leave_requests">
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

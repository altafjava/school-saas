<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Phase 2.1 — one append-only history spanning Admission → Enrollment → Alumni. Before
         enrollment only admission_id is set, the enrollment step sets both, afterwards only
         student_id (see LifecycleTransition). -->
    <changeSet id="school-145-lifecycle-transitions" author="school">
        <createTable tableName="lifecycle_transitions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="admission_id" type="BIGINT"/>
            <column name="student_id" type="BIGINT"/>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="effective_on" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="recorded_by_user_id" type="BIGINT"/>
            <column name="from_stage" type="VARCHAR(20)"/>
            <column name="to_stage" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE lifecycle_transitions
                ADD CONSTRAINT chk_lifecycle_transitions_has_subject
                CHECK (admission_id IS NOT NULL OR student_id IS NOT NULL);
        </sql>
        <createIndex indexName="idx_lifecycle_transitions_tenant_student" tableName="lifecycle_transitions">
            <column name="tenant_id"/>
            <column name="student_id"/>
        </createIndex>
        <createIndex indexName="idx_lifecycle_transitions_tenant_admission" tableName="lifecycle_transitions">
            <column name="tenant_id"/>
            <column name="admission_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_lifecycle_transitions_tenant_id"
                baseTableName="lifecycle_transitions"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_lifecycle_transitions_admission_id"
                baseTableName="lifecycle_transitions"
                baseColumnNames="admission_id"
                referencedTableName="admissions"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_lifecycle_transitions_student_id"
                baseTableName="lifecycle_transitions"
                baseColumnNames="student_id"
                referencedTableName="students"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

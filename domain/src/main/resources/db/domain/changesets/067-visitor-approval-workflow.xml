<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Phase 3.7 — every visit starts as a request (pre-registered by a host, or raised at the front
         desk for a walk-in) that the host or a security approver accepts before the visitor can be
         checked in; check-in records the visitor's photo and issues a badge. Hosts are employees, not
         only teachers — a clerk or the principal can host too. -->

    <changeSet id="school-170-visitor-requests" author="school">
        <createTable tableName="visitor_requests">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="visitor_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="visitor_phone" type="VARCHAR(50)"/>
            <column name="purpose" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="host_employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="visit_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="source" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="photo_file_public_id" type="UUID"/>
            <column name="requested_by_user_id" type="BIGINT"/>
            <column name="decided_by_user_id" type="BIGINT"/>
            <column name="decided_at" type="TIMESTAMP"/>
            <column name="decision_reason" type="VARCHAR(500)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_visitor_requests_tenant_id"
                baseTableName="visitor_requests" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_visitor_requests_host_employee_id"
                baseTableName="visitor_requests" baseColumnNames="host_employee_id"
                referencedTableName="employees" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_visitor_requests_photo_file_public_id"
                baseTableName="visitor_requests" baseColumnNames="photo_file_public_id"
                referencedTableName="file_metadata" referencedColumnNames="public_id"/>
        <createIndex indexName="idx_visitor_requests_tenant_id" tableName="visitor_requests">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_visitor_requests_tenant_status_date" tableName="visitor_requests">
            <column name="tenant_id"/>
            <column name="status"/>
            <column name="visit_date"/>
        </createIndex>
        <createIndex indexName="idx_visitor_requests_host_employee_id" tableName="visitor_requests">
            <column name="host_employee_id"/>
        </createIndex>
        <createIndex indexName="idx_visitor_requests_deleted" tableName="visitor_requests">
            <column name="deleted"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-171-visitor-logs-follow-requests" author="school">
        <dropForeignKeyConstraint baseTableName="visitor_logs" constraintName="fk_visitor_logs_host_teacher_id"/>
        <dropIndex tableName="visitor_logs" indexName="idx_visitor_logs_host_teacher_id"/>
        <renameColumn tableName="visitor_logs" oldColumnName="host_teacher_id" newColumnName="host_employee_id"
                      columnDataType="BIGINT"/>
        <addColumn tableName="visitor_logs">
            <column name="visitor_request_id" type="BIGINT"/>
            <column name="photo_file_public_id" type="UUID"/>
            <column name="badge_issuance_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_visitor_logs_host_employee_id"
                baseTableName="visitor_logs" baseColumnNames="host_employee_id"
                referencedTableName="employees" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_visitor_logs_visitor_request_id"
                baseTableName="visitor_logs" baseColumnNames="visitor_request_id"
                referencedTableName="visitor_requests" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_visitor_logs_photo_file_public_id"
                baseTableName="visitor_logs" baseColumnNames="photo_file_public_id"
                referencedTableName="file_metadata" referencedColumnNames="public_id"/>
        <addForeignKeyConstraint constraintName="fk_visitor_logs_badge_issuance_id"
                baseTableName="visitor_logs" baseColumnNames="badge_issuance_id"
                referencedTableName="document_issuances" referencedColumnNames="id"/>
        <createIndex indexName="idx_visitor_logs_host_employee_id" tableName="visitor_logs">
            <column name="host_employee_id"/>
        </createIndex>
        <!-- A request admits one visit; legacy logs without one (NULL) never collide. -->
        <createIndex indexName="uq_visitor_logs_visitor_request_id" tableName="visitor_logs" unique="true">
            <column name="visitor_request_id"/>
        </createIndex>
    </changeSet>

    <!-- Hosting is self-service (the service checks the caller is the host), so it goes to the staff
         roles, not TENANT_ADMIN; approving anyone's visit is the separate VISITOR_REQUEST_APPROVE. -->
    <changeSet id="school-172-visitor-request-permissions" author="school">
        <sql>
            UPDATE roles
            SET permissions_json = JSON_MERGE_PRESERVE(permissions_json, '["VISITOR_REQUEST_SELF_SERVICE"]')
            WHERE name IN ('TEACHER', 'PRINCIPAL', 'FINANCE', 'HR', 'ACADEMIC');
        </sql>
        <sql>
            UPDATE roles
            SET permissions_json = JSON_MERGE_PRESERVE(permissions_json, '["VISITOR_REQUEST_APPROVE"]')
            WHERE name IN ('TENANT_ADMIN', 'PRINCIPAL');
        </sql>
    </changeSet>

</databaseChangeLog>

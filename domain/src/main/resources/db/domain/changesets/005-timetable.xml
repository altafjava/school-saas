<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-013-periods" author="school">
        <createTable tableName="periods">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="start_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="display_order" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE periods
                ADD COLUMN active_name VARCHAR(50)
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN name ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="idx_periods_tenant_id" tableName="periods">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_periods_deleted" tableName="periods">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="uq_periods_active_name_tenant" tableName="periods" unique="true">
            <column name="active_name"/>
            <column name="tenant_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_periods_tenant_id"
                baseTableName="periods"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="school-014-timetable-entries" author="school">
        <createTable tableName="timetable_entries">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="period_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="classroom_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="subject_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="teacher_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="venue_id" type="BIGINT"/>
            <column name="day_of_week" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE timetable_entries
                ADD COLUMN active_classroom_id BIGINT
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN classroom_id ELSE NULL END) STORED;
        </sql>
        <sql>
            ALTER TABLE timetable_entries
                ADD COLUMN active_teacher_id BIGINT
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN teacher_id ELSE NULL END) STORED;
        </sql>
        <sql>
            ALTER TABLE timetable_entries
                ADD COLUMN active_venue_id BIGINT
                GENERATED ALWAYS AS (CASE WHEN deleted = FALSE THEN venue_id ELSE NULL END) STORED;
        </sql>
        <createIndex indexName="idx_timetable_entries_tenant_id" tableName="timetable_entries">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_timetable_entries_deleted" tableName="timetable_entries">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_timetable_entries_period_id" tableName="timetable_entries">
            <column name="period_id"/>
        </createIndex>
        <createIndex indexName="idx_timetable_entries_classroom_id" tableName="timetable_entries">
            <column name="classroom_id"/>
        </createIndex>
        <createIndex indexName="idx_timetable_entries_subject_id" tableName="timetable_entries">
            <column name="subject_id"/>
        </createIndex>
        <createIndex indexName="idx_timetable_entries_teacher_id" tableName="timetable_entries">
            <column name="teacher_id"/>
        </createIndex>
        <createIndex indexName="uq_timetable_active_classroom_period_day" tableName="timetable_entries" unique="true">
            <column name="tenant_id"/>
            <column name="day_of_week"/>
            <column name="period_id"/>
            <column name="active_classroom_id"/>
        </createIndex>
        <createIndex indexName="uq_timetable_active_teacher_period_day" tableName="timetable_entries" unique="true">
            <column name="tenant_id"/>
            <column name="day_of_week"/>
            <column name="period_id"/>
            <column name="active_teacher_id"/>
        </createIndex>
        <createIndex indexName="idx_timetable_entries_venue_id" tableName="timetable_entries">
            <column name="venue_id"/>
        </createIndex>
        <createIndex indexName="uq_timetable_active_venue_period_day" tableName="timetable_entries" unique="true">
            <column name="tenant_id"/>
            <column name="day_of_week"/>
            <column name="period_id"/>
            <column name="active_venue_id"/>
        </createIndex>
        <addForeignKeyConstraint
                constraintName="fk_timetable_entries_tenant_id"
                baseTableName="timetable_entries"
                baseColumnNames="tenant_id"
                referencedTableName="tenants"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_timetable_entries_period_id"
                baseTableName="timetable_entries"
                baseColumnNames="period_id"
                referencedTableName="periods"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_timetable_entries_classroom_id"
                baseTableName="timetable_entries"
                baseColumnNames="classroom_id"
                referencedTableName="classrooms"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_timetable_entries_subject_id"
                baseTableName="timetable_entries"
                baseColumnNames="subject_id"
                referencedTableName="subjects"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_timetable_entries_teacher_id"
                baseTableName="timetable_entries"
                baseColumnNames="teacher_id"
                referencedTableName="teachers"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>

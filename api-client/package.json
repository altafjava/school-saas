{
  "name": "@school/api-client",
  "version": "0.0.0-development",
  "description": "Typed TypeScript client for the school-saas REST API, generated from its committed OpenAPI snapshot: fetch functions, TanStack Query hooks, zod schemas and MSW mocks.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altafjava/school-saas.git",
    "directory": "api-client"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    },
    "./mocks": {
      "types": "./dist/mocks.d.ts",
      "default": "./dist/mocks.js"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts && node scripts/generate-barrels.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "build": "npm run generate && rm -rf dist && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0",
    "msw": "^3.0.0",
    "@faker-js/faker": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "@faker-js/faker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@tanstack/react-query": "5.104.1",
    "@types/react": "19.3.0",
    "msw": "3.0.2",
    "orval": "8.41.0",
    "react": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}

# Keeps the Docker build context small and the build reproducible from source only —
# nothing here should ever influence the image (build outputs, IDE state, local secrets).

.git/
.gradle/
**/build/
**/bin/
out/
*.class

.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.factorypath
.vscode/

docker-compose.yml
*.md
docs/

# Frontend client package: generated from the spec, not part of the service image.
api-client/

# Never bake local dev secrets into the build context.
.env
.env.*
